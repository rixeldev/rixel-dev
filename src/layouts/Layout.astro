---
import Contact from "@/components/Contact.astro"
import Footer from "@/components/Footer.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import SEO from "@/components/SEO.astro"
import BackgroundGradient from "@/components/ui/BackgroundGradient.astro"
import GoToTop from "@/components/ui/GoToTop.astro"
import Header from "@/components/ui/Header.astro"
import Toast from "@/components/ui/Toast.astro"
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro"
import type { Preload } from "@/interfaces/preload"
import { getActiveLocale } from "@/locales/index"
import "@/styles/global.css"
import "@fontsource-variable/azeret-mono"
import "@fontsource-variable/bricolage-grotesque"
import "@fontsource-variable/onest"
import SpeedInsights from "@vercel/speed-insights/astro"
import { ClientRouter } from "astro:transitions"

interface Props {
	title: string
	description: string
	preload?: Array<Preload>
	canonical?: string
	image?: string
	imageWidth?: number
	imageHeight?: number
	keywords?: string
	jsonLd?: Record<string, unknown> | Record<string, unknown>[]
	type?: "website" | "article" | "profile"
	noindex?: boolean
	publishedTime?: string
	modifiedTime?: string
	author?: string
	section?: string
	tags?: string[]
	alternates?: { lang: string; href: string }[]
	contact?: boolean
}

const {
	title,
	description,
	preload,
	canonical,
	image,
	imageWidth,
	imageHeight,
	keywords,
	jsonLd,
	type,
	noindex,
	publishedTime,
	modifiedTime,
	author,
	section,
	tags,
	alternates,
	contact = true,
} = Astro.props
const locale = getActiveLocale(Astro)
---

<!doctype html>
<html lang={locale} translate="no">
	<head>
		<SEO
			locale={locale}
			canonical={canonical}
			description={description}
			image={image}
			imageWidth={imageWidth}
			imageHeight={imageHeight}
			jsonLd={jsonLd}
			keywords={keywords}
			preload={preload}
			title={title}
			type={type}
			noindex={noindex}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			author={author}
			section={section}
			tags={tags}
			alternates={alternates}
		/>
		<ClientRouter />
	</head>
	<body class="relative w-full overflow-x-hidden bg-ink">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-accent focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-accent-ink"
		>
			Skip to content
		</a>

		<SpeedInsights />

		<BackgroundGradient />
		<div class="grain-overlay pointer-events-none fixed inset-0 z-0 opacity-5" aria-hidden="true">
		</div>

		<WhatsAppButton />
		<GoToTop />
		<Toast />

		<Header locale={locale} />

		<main id="main" class="relative z-10 w-full min-w-0 overflow-x-hidden">
			<slot />

			{
				contact && (
					<SectionContainer id="contact" class="pb-24 pt-10 sm:pt-16">
						<Contact locale={locale} />
					</SectionContainer>
				)
			}
		</main>

		<Footer locale={locale} />
	</body>
</html>
