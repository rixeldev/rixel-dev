---
import ActionLink from "@/components/ui/ActionLink.astro"
import RightArrow from "@/icons/RightArrow.astro"
import { getActiveLocale, getI18N, resolveLocalizedHref } from "@/locales/index"
import { projectsService } from "@/services/projects"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const projectCount = projectsService(locale).length

const stats = [
	{ value: "5+", label: i18n.HOME_STAT_YEARS_LABEL },
	{ value: `${projectCount}`, label: i18n.HOME_STAT_PROJECTS_LABEL },
	{ value: "2", label: i18n.HOME_STAT_APPS_LABEL },
]
---

<div class="grid w-full min-w-0 items-end gap-14 lg:grid-cols-12 lg:gap-10">
	<div class="flex min-w-0 flex-col gap-8 lg:col-span-7">
		<p
			class="inline-flex w-fit items-center gap-2.5 rounded-full border border-line bg-bone/5 px-4 py-1.5 font-mono text-xs uppercase tracking-widest text-secondary"
		>
			<span class="relative flex size-2">
				<span class="absolute inset-0 animate-ping rounded-full bg-accent opacity-60"></span>
				<span class="relative size-2 rounded-full bg-accent"></span>
			</span>
			{i18n.AVAILABLE}
		</p>

		<h1
			class="display-balance font-display text-5xl leading-none text-bone sm:text-6xl lg:text-7xl"
		>
			<span class="block">{i18n.HOME_TITLE_1}</span>
			<span class="block text-accent">{i18n.HOME_TITLE_EM}</span>
			<span class="block">{i18n.HOME_TITLE_2}</span>
		</h1>

		<p class="max-w-xl text-pretty text-base leading-relaxed text-primary sm:text-lg">
			{i18n.HOME_LEAD}
		</p>

		<div class="flex flex-wrap items-center gap-3">
			<ActionLink href={resolveLocalizedHref("/apps", locale)} size="lg">
				{i18n.HOME_CTA_APPS}
				<RightArrow class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" />
			</ActionLink>

			<ActionLink href={resolveLocalizedHref("/portfolio", locale)} variant="ghost" size="lg">
				{i18n.HOME_CTA_WORK}
			</ActionLink>

			<ActionLink href="#contact" variant="line" size="lg">
				{i18n.HOME_CTA_CONTACT}
			</ActionLink>
		</div>

		<dl class="grid max-w-lg grid-cols-3 gap-6 border-t border-line pt-6">
			{
				stats.map((stat) => (
					<div class="flex flex-col gap-1">
						<dt class="order-2 font-mono text-xs uppercase tracking-wider text-secondary">
							{stat.label}
						</dt>
						<dd class="order-1 font-display text-3xl text-bone sm:text-4xl">{stat.value}</dd>
					</div>
				))
			}
		</dl>
	</div>

	<div class="relative mx-auto w-full max-w-sm lg:col-span-5 lg:max-w-none">
		<div
			class="pointer-events-none absolute -inset-6 rounded-5xl bg-accent/10 opacity-70 blur-3xl"
			aria-hidden="true"
		>
		</div>

		<figure class="relative">
			<div class="relative overflow-hidden rounded-4xl border border-line bg-ink-panel p-2">
				<img
					src="/images/main-pic.webp"
					width="630"
					height="1200"
					alt="Portrait of Rikelvi Capellán"
					fetchpriority="high"
					decoding="async"
					class="aspect-portrait w-full rounded-3xl object-cover object-center"
				/>

				<div
					class="pointer-events-none absolute inset-2 rounded-3xl bg-gradient-to-t from-ink/60 via-transparent to-transparent"
					aria-hidden="true"
				>
				</div>

				<span
					class="absolute left-5 top-5 rounded-full border border-line bg-ink/70 px-3 py-1 font-mono text-xs uppercase tracking-widest text-bone backdrop-blur-md"
				>
					Rixel<span class="text-accent">.</span>dev
				</span>
			</div>

			<figcaption
				class="mt-4 flex items-center justify-between gap-2 font-mono text-xs uppercase tracking-widest text-secondary"
			>
				<span>Rikelvi Capellán</span>
				<span>{i18n.HOME_LOCATION}</span>
			</figcaption>
		</figure>
	</div>
</div>
