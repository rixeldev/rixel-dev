---
import Badge from "@/components/Badge.astro"
import Chat from "@/icons/Chat.astro"
import Check from "@/icons/Check.astro"
import RightArrow from "@/icons/RightArrow.astro"
import Timeline from "@/icons/Timeline.astro"
import { getActiveLocale, getI18N, resolveLocalizedHref } from "@/locales/index"
import { projectsService } from "@/services/projects"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const projectCount = projectsService(locale).length

const stats = [
	{ value: "5+", label: i18n.HOME_STAT_YEARS_LABEL },
	{ value: `${projectCount}+`, label: i18n.HOME_STAT_PROJECTS_LABEL },
	{ value: "15+", label: i18n.HOME_STAT_STACK_LABEL },
]
---

<div
	class="relative flex w-full min-w-0 max-w-6xl flex-col items-center gap-12 sm:w-11/12 lg:flex-row lg:items-center lg:justify-between lg:gap-16"
>
	<div
		class="pointer-events-none absolute -left-16 top-0 size-48 rounded-full bg-accent/10 blur-3xl lg:-left-32 lg:size-72"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute -right-8 bottom-0 size-40 rounded-full bg-main/20 blur-3xl lg:-right-20 lg:size-56"
		aria-hidden="true"
	>
	</div>

	<div
		class="fade-up-anim relative z-10 flex w-full min-w-0 max-w-2xl flex-col items-center text-center lg:items-start lg:text-left"
	>
		<p
			class="mb-5 inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/5 px-4 py-1.5 text-sm font-medium text-accent"
		>
			<span class="relative flex size-2 overflow-hidden rounded-full">
				<span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60"
				></span>
				<span class="relative inline-flex size-2 rounded-full bg-accent"></span>
			</span>
			{i18n.HOME_HERO_GREETING}
		</p>

		<h1
			class="text-balance bg-gradient-to-br from-white via-slate-200 to-slate-400 bg-clip-text text-4xl font-bold tracking-tight text-transparent sm:text-5xl md:text-6xl lg:text-7xl"
		>
			Rikelvi Capellán
		</h1>

		<p class="mt-4 text-lg font-semibold text-slate-300 sm:text-xl">
			{i18n.ABOUT_TEXT_1}
		</p>

		<p class="mt-4 max-w-xl text-pretty text-base leading-relaxed text-primary sm:text-lg">
			{i18n.HOME_HERO_TAGLINE}
		</p>

		<div class="mt-6">
			<Badge>
				<Check class="mr-2 size-5 text-accent" />
				<span class="font-bold text-accent">{i18n.AVAILABLE}</span>
			</Badge>
		</div>

		<div class="mt-8 flex w-full flex-wrap items-center justify-center gap-3 lg:justify-start">
			<a
				href={resolveLocalizedHref("/portfolio", locale)}
				class="group inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-accent/25 transition-all duration-300 hover:bg-accent/90 hover:shadow-xl hover:shadow-accent/30 active:scale-95 sm:hover:-translate-y-0.5"
			>
				{i18n.HOME_CTA_WORK}
				<RightArrow class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" />
			</a>

			<a
				href={resolveLocalizedHref("#contact", locale)}
				class="inline-flex items-center gap-2 rounded-full border border-secondary/30 bg-white/5 px-6 py-3 text-sm font-semibold text-primary backdrop-blur-sm transition-all duration-300 hover:border-accent/40 hover:bg-accent/10 hover:text-accent active:scale-95 sm:hover:-translate-y-0.5"
			>
				<Chat class="size-4" />
				{i18n.HOME_CTA_CONTACT}
			</a>

			<a
				href={resolveLocalizedHref("/photography", locale)}
				class="inline-flex items-center gap-2 rounded-full px-4 py-3 text-sm font-medium text-secondary transition-colors duration-300 hover:text-accent"
			>
				<Timeline class="size-4" />
				{i18n.PHOTOGRAPHY}
			</a>
		</div>

		<dl
			class="mt-10 grid w-full max-w-md grid-cols-3 gap-4 border-t border-white/10 pt-6 text-center lg:text-left"
		>
			{
				stats.map((stat) => (
					<div class="flex flex-col gap-1">
						<dt class="sr-only">{stat.label}</dt>
						<dd class="text-2xl font-bold text-slate-100 sm:text-3xl">{stat.value}</dd>
						<dd class="text-xs font-medium uppercase tracking-wider text-secondary">
							{stat.label}
						</dd>
					</div>
				))
			}
		</dl>
	</div>

	<div class="fade-up-anim relative z-10 shrink-0">
		<div
			class="relative max-lg:mx-auto max-lg:max-w-[17.5rem] max-lg:overflow-hidden max-lg:px-1"
		>
			<div
				class="pointer-events-none absolute inset-0 rounded-[2rem] bg-gradient-to-br from-accent/30 via-transparent to-main/30 opacity-60 blur-2xl lg:-inset-4"
				aria-hidden="true"
			>
			</div>

			<div
				class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-br from-slate-800/50 to-slate-900/80 p-1.5 shadow-2xl shadow-black/50 backdrop-blur-sm"
			>
				<img
					src="https://rixel.dev/images/main-pic.webp"
					width="630"
					height="1200"
					alt="Rikelvi Capellán"
					fetchpriority="high"
					decoding="async"
					class="aspect-[4/5] w-56 rounded-[1.6rem] object-cover object-center sm:w-64 md:w-72 lg:w-80"
				/>
			</div>

			<div
				class="absolute bottom-2 left-1/2 z-10 -translate-x-1/2 rounded-2xl border border-accent/20 bg-slate-900/90 px-4 py-2 shadow-xl backdrop-blur-md lg:-bottom-3 lg:-right-3 lg:left-auto lg:translate-x-0"
			>
				<p class="whitespace-nowrap text-xs font-medium text-secondary">{i18n.HOME_LOCATION}</p>
			</div>
		</div>
	</div>
</div>
