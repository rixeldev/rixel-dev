---
import MainTitle from "@/components/MainTitle.astro"
import GitHub from "@/icons/GitHub.astro"
import RightArrow from "@/icons/RightArrow.astro"
import { getActiveLocale, getI18N, resolveLocalizedHref } from "@/locales/index"
import { projectsService } from "@/services/projects"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const featured = projectsService(locale).slice(0, 4)
const portfolioHref = resolveLocalizedHref("/portfolio#projects", locale)
---

<div class="flex w-full min-w-0 flex-col">
	<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
		<MainTitle eyebrow={i18n.FEATURED_EYEBROW} title={i18n.FEATURED_TITLE} />

		<a
			href={portfolioHref}
			class="group mb-2 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-secondary transition-colors hover:text-accent"
		>
			{i18n.HOME_VIEW_ALL_PROJECTS}
			<RightArrow class="size-4 transition-transform group-hover:translate-x-0.5" />
		</a>
	</div>

	<div class="mt-10 grid gap-4 md:grid-cols-2">
		{
			featured.map((project) => (
				<article class="group flex h-full min-w-0 flex-col overflow-hidden rounded-3xl border border-line bg-ink-panel">
					<a
						href={project.projectUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="relative block overflow-hidden"
						aria-label={`${project.title} — ${i18n.SQUINT}`}
					>
						<img
							src={project.imgUrl}
							alt={project.alt}
							width="1280"
							height="720"
							decoding="async"
							loading="lazy"
							class="aspect-video w-full object-cover object-top opacity-90 transition-all duration-700 group-hover:scale-105 group-hover:opacity-100"
						/>

						<span class="absolute right-4 top-4 flex size-9 translate-y-1 items-center justify-center rounded-full bg-accent text-accent-ink opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
							<RightArrow class="size-4 -rotate-45" />
						</span>
					</a>

					<div class="flex flex-1 flex-col gap-3 p-6">
						<ul class="flex flex-wrap gap-2">
							{project.tags.map((tag) => (
								<li class="inline-flex items-center gap-1.5 rounded-full border border-line px-2.5 py-1 font-mono text-xs text-secondary">
									<tag.icon class="size-3" />
									{tag.name}
								</li>
							))}
						</ul>

						<h3 class="font-display text-2xl text-bone">
							<a
								href={project.projectUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="transition-colors hover:text-accent"
							>
								{project.title}
							</a>
						</h3>

						<p class="line-clamp-2 text-sm leading-relaxed text-primary">{project.description}</p>

						<footer class="mt-auto flex items-center justify-between gap-4 border-t border-line pt-4">
							<a
								href={project.projectUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-accent"
							>
								{i18n.SQUINT}
								<RightArrow class="size-3.5 transition-transform group-hover:translate-x-0.5" />
							</a>

							<a
								href={project.gitCodeUrl}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${project.title} — GitHub`}
								class="text-secondary transition-colors hover:text-bone"
							>
								<GitHub class="size-4" />
							</a>
						</footer>
					</div>
				</article>
			))
		}
	</div>
</div>
