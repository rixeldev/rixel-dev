---
import MainTitle from "@/components/MainTitle.astro"
import UpArrow from "@/icons/UpArrow.astro"
import { estimateReadingTime, sortArticlesByDate } from "@/libs/articlesSeo"
import { getActiveLocale, getI18N, resolveLocalizedHref } from "@/locales/index"
import { getCollection } from "astro:content"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })

const articles = sortArticlesByDate(await getCollection("articles")).slice(0, 4)
---

<div class="flex w-full min-w-0 flex-col">
	<MainTitle eyebrow={i18n.ARTICLES_EYEBROW} title={i18n.ARTICLES} />

	<ul class="mt-8 flex flex-col border-t border-line">
		{
			articles.map((article) => {
				const { data, body } = article
				const minutes = estimateReadingTime(body)

				return (
					<li class="border-b border-line">
						<a
							href={resolveLocalizedHref(`/articles/${data.pageTitle}`, locale)}
							class="group grid grid-cols-1 items-baseline gap-2 py-5 sm:grid-cols-12 sm:gap-4"
						>
							<time
								datetime={data.timestamp}
								class="font-mono text-xs uppercase tracking-wider text-secondary sm:col-span-3"
							>
								{data.timestamp}
							</time>

							<h3 class="font-display text-xl leading-snug text-bone transition-colors duration-300 group-hover:text-accent sm:col-span-7 sm:text-2xl">
								{data.title}
							</h3>

							<span class="font-mono text-xs text-secondary sm:col-span-2 sm:text-right">
								{i18n.ARTICLE_READING_TIME.replace("{minutes}", String(minutes))}
							</span>
						</a>
					</li>
				)
			})
		}
	</ul>

	<a
		href={resolveLocalizedHref("/articles", locale)}
		class="group mt-6 inline-flex w-fit items-center gap-2 font-mono text-xs uppercase tracking-widest text-secondary transition-colors hover:text-accent"
	>
		<span>{i18n.VIEW_ALL_ARTICLES}</span>
		<UpArrow class="size-3.5 rotate-90 transition-transform group-hover:translate-x-0.5" />
	</a>
</div>
