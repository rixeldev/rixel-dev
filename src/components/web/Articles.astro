---
import HomeArticleCard from "@/components/HomeArticleCard.astro"
import MainTitle from "@/components/MainTitle.astro"
import Book from "@/icons/Book.astro"
import UpArrow from "@/icons/UpArrow.astro"
import { sortArticlesByDate } from "@/libs/articlesSeo"
import { getActiveLocale, getI18N, resolveLocalizedHref } from "@/locales/index"
import { getCollection } from "astro:content"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })

const articles = sortArticlesByDate(await getCollection("articles")).slice(0, 4)
---

<div class="flex w-full min-w-0 flex-col">
	<MainTitle eyebrow={i18n.ARTICLES_EYEBROW}>
		<Book class="size-7 text-accent" />
		{i18n.ARTICLES}
	</MainTitle>

	<div class="grid w-full gap-3 sm:grid-cols-2">
		{
			articles.map((article) => {
				const { data } = article
				const { author, description, lang, pageTitle, timestamp, title } = data

				return (
					<HomeArticleCard
						author={author}
						description={description}
						lang={lang}
						pageTitle={pageTitle}
						timestamp={timestamp}
						title={title}
					/>
				)
			})
		}
	</div>

	<a
		href={resolveLocalizedHref("/articles", locale)}
		class="group mt-6 inline-flex w-fit items-center gap-2 rounded-full border border-secondary/20 bg-secondary/5 px-5 py-2.5 text-sm font-medium text-secondary transition-all active:border-accent/30 active:text-accent sm:cursor-pointer sm:hover:border-accent/30 sm:hover:bg-accent/10 sm:hover:text-accent"
	>
		<span>{i18n.VIEW_ALL_ARTICLES}</span>
		<UpArrow class="size-4 rotate-90 transition-transform group-hover:translate-x-0.5" />
	</a>
</div>
