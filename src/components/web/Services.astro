---
import MainTitle from "@/components/MainTitle.astro"
import ActionLink from "@/components/ui/ActionLink.astro"
import Android from "@/icons/Android.astro"
import Code from "@/icons/Code.astro"
import Photography from "@/icons/Photography.astro"
import World from "@/icons/World.astro"
import { getActiveLocale, getI18N, resolveLocalizedHref } from "@/locales/index"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })

const services = [
	{ icon: Code, title: i18n.SERVICE_WEB_TITLE, description: i18n.SERVICE_WEB_DESC },
	{ icon: Android, title: i18n.SERVICE_MOBILE_TITLE, description: i18n.SERVICE_MOBILE_DESC },
	{ icon: World, title: i18n.SERVICE_PERF_TITLE, description: i18n.SERVICE_PERF_DESC },
	{ icon: Photography, title: i18n.SERVICE_PHOTO_TITLE, description: i18n.SERVICE_PHOTO_DESC },
]
---

<div class="grid w-full min-w-0 gap-12 lg:grid-cols-12 lg:gap-16">
	<div class="flex flex-col gap-7 self-start lg:sticky lg:top-28 lg:col-span-4">
		<MainTitle eyebrow={i18n.SERVICES_EYEBROW} title={i18n.SERVICES_TITLE} />

		<p class="max-w-md text-pretty leading-relaxed text-primary">
			{i18n.SERVICES_SUBTITLE}
		</p>

		<ActionLink href={resolveLocalizedHref("/#contact", locale)} variant="ghost" class="self-start">
			{i18n.HOME_CTA_CONTACT}
		</ActionLink>
	</div>

	<ul class="flex min-w-0 flex-col border-t border-line lg:col-span-8">
		{
			services.map((service) => (
				<li class="group border-b border-line">
					<div class="flex items-start gap-4 py-6 transition-colors duration-300 sm:gap-6 sm:py-8">
						<div class="flex min-w-0 flex-1 flex-col gap-2">
							<div class="flex items-center justify-between gap-4">
								<h3 class="font-display text-2xl text-bone transition-colors duration-300 group-hover:text-accent sm:text-3xl">
									{service.title}
								</h3>
								<service.icon class="size-5 shrink-0 text-secondary transition-colors duration-300 group-hover:text-accent" />
							</div>

							<p class="max-w-xl text-sm leading-relaxed text-primary">{service.description}</p>
						</div>
					</div>
				</li>
			))
		}
	</ul>
</div>
