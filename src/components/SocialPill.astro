---
const { class: className, ...rest } = Astro.props
---

<a
	{...rest}
	class:list={[
		"group inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border border-line bg-bone/5 px-4 py-2 text-sm font-medium text-primary transition-colors duration-300 hover:border-accent/40 hover:text-accent active:scale-95",
		className,
	]}
>
	<slot />
</a>
