---
import Divider from "@/components/Divider.astro"
import ProjectsCard from "@/components/ProjectsCard.astro"
import Code from "@/icons/Code.astro"
import { type Project } from "@/interfaces/project"
import { getActiveLocale, getI18N } from "@/locales/index.ts"
import { projectsService } from "@/services/projects"
import MainTitle from "../MainTitle.astro"
import ProjectsTecnologies from "./ProjectsTecnologies.astro"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const allProjects: Project[] = projectsService(locale).slice(0, 4)
---

<div class="flex w-full max-w-4xl flex-col sm:w-11/12 md:w-8/12">
	<MainTitle eyebrow={i18n.PORTFOLIO}>
		<Code class="size-8" />
		{i18n.PROJECTS}
	</MainTitle>

	<div class="flex flex-col gap-y-16">
		{
			allProjects.map(({ title, description, imgUrl, projectUrl, tags, gitCodeUrl, alt }) => (
				<ProjectsCard
					title={title}
					description={description}
					imgUrl={imgUrl}
					projectUrl={projectUrl}
					tags={tags}
					gitCodeUrl={gitCodeUrl}
					alt={alt}
				/>
			))
		}
	</div>

	<Divider />

	<ProjectsTecnologies />
</div>
