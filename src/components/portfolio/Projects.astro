---
import MainTitle from "@/components/MainTitle.astro"
import ProjectsCard from "@/components/ProjectsCard.astro"
import { getActiveLocale, getI18N } from "@/locales/index.ts"
import { projectsService } from "@/services/projects"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const allProjects = projectsService(locale)
---

<div class="flex w-full flex-col gap-10">
	<MainTitle eyebrow={i18n.PORTFOLIO} title={i18n.PROJECTS} />

	<div class="grid gap-4 md:grid-cols-2">
		{
			allProjects.map((project) => (
				<ProjectsCard
					title={project.title}
					description={project.description}
					imgUrl={project.imgUrl}
					projectUrl={project.projectUrl}
					tags={project.tags}
					gitCodeUrl={project.gitCodeUrl}
					alt={project.alt}
				/>
			))
		}
	</div>
</div>
