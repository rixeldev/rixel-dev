---
import MainTitle from "@/components/MainTitle.astro"
import Android from "@/icons/Android.astro"
import Angular from "@/icons/Angular.astro"
import AstroBrand from "@/icons/AstroBrand.astro"
import Bootstrap from "@/icons/Bootstrap.astro"
import Code from "@/icons/Code.astro"
import CSS from "@/icons/CSS.astro"
import Firebase from "@/icons/Firebase.astro"
import Git from "@/icons/Git.astro"
import GitHub from "@/icons/GitHub.astro"
import HTML from "@/icons/HTML.astro"
import JS from "@/icons/JS.astro"
import Kotlin from "@/icons/Kotlin.astro"
import NodeJS from "@/icons/NodeJS.astro"
import React from "@/icons/React.astro"
import ReactNative from "@/icons/ReactNative.astro"
import SQL from "@/icons/SQL.astro"
import Supabase from "@/icons/Supabase.astro"
import Tailwind from "@/icons/Tailwind.astro"
import TS from "@/icons/TS.astro"
import { getActiveLocale, getI18N } from "@/locales/index"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })

const skillGroups = [
	{
		title: i18n.SKILLS_GROUP_FRONTEND,
		icon: Code,
		skills: [
			{ name: "HTML", icon: HTML },
			{ name: "CSS", icon: CSS },
			{ name: "JavaScript", icon: JS },
			{ name: "TypeScript", icon: TS },
			{ name: "Astro", icon: AstroBrand },
			{ name: "React", icon: React },
			{ name: "Angular", icon: Angular },
			{ name: "Tailwind CSS", icon: Tailwind },
			{ name: "Bootstrap", icon: Bootstrap },
		],
	},
	{
		title: i18n.SKILLS_GROUP_BACKEND,
		icon: SQL,
		skills: [
			{ name: "Node.js", icon: NodeJS },
			{ name: "SQL", icon: SQL },
			{ name: "Supabase", icon: Supabase },
			{ name: "Firebase", icon: Firebase },
		],
	},
	{
		title: i18n.SKILLS_GROUP_MOBILE,
		icon: Android,
		skills: [
			{ name: "Kotlin", icon: Kotlin },
			{ name: "React Native", icon: ReactNative },
			{ name: "Android", icon: Android },
		],
	},
	{
		title: i18n.SKILLS_GROUP_TOOLS,
		icon: Git,
		skills: [
			{ name: "Git", icon: Git },
			{ name: "GitHub", icon: GitHub },
		],
	},
]
---

<div class="flex w-full flex-col gap-10">
	<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
		<MainTitle eyebrow={i18n.SKILLS_EYEBROW} title={i18n.SKILLS_TITLE} />

		<p class="max-w-md text-pretty text-base leading-relaxed text-primary">
			{i18n.SKILLS_SUBTITLE}
		</p>
	</div>

	<div class="grid w-full gap-4 md:grid-cols-2">
		{
			skillGroups.map((group) => (
				<div class="group relative flex h-full flex-col gap-5 overflow-hidden rounded-3xl border border-line bg-ink-panel p-6 transition-colors duration-300 hover:border-accent/30 sm:p-7">
					<div
						class="pointer-events-none absolute -right-16 -top-16 size-40 rounded-full bg-accent/5 blur-2xl transition-opacity duration-300 group-hover:opacity-100"
						aria-hidden="true"
					/>

					<div class="relative flex items-center gap-3 border-b border-line pb-4">
						<span class="flex size-10 shrink-0 items-center justify-center rounded-xl border border-line bg-bone/5 text-accent">
							<group.icon class="size-5" />
						</span>
						<h3 class="font-display text-2xl font-semibold text-bone">{group.title}</h3>
					</div>

					<ul class="relative flex flex-wrap gap-2">
						{group.skills.map((skill) => (
							<li class="inline-flex items-center gap-2 rounded-full border border-line bg-bone/5 px-3 py-1.5 text-sm text-primary transition-colors hover:border-accent/40 hover:text-accent">
								<skill.icon class="size-3.5" />
								{skill.name}
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</div>
