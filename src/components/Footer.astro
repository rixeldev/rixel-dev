---
import { footerLinks, footerNavItems } from "@/libs/consts"
import { getActiveLocale, getI18N, resolveLocalizedHref } from "@/locales/index"

interface Props {
	locale?: string
}

const { locale: forcedLocale } = Astro.props as Props
const locale = forcedLocale ?? getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const socialLinks = footerLinks()
const columns = footerNavItems(locale)
const year = new Date().getFullYear()
---

<footer class="relative z-10 border-t border-line bg-ink/70">
	<div class="mx-auto flex w-full max-w-6xl flex-col gap-14 px-4 py-16 sm:px-6 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-12">
			<div class="flex flex-col gap-6 lg:col-span-5">
				<a
					href={resolveLocalizedHref("/", locale)}
					class="inline-flex items-center gap-3 self-start"
					aria-label="Rixel.dev — home"
				>
					<span
						class="flex size-10 items-center justify-center rounded-xl border border-line bg-bone/5 p-2"
					>
						<img src="/brand-svg.svg" alt="" width="24" height="24" class="size-full" />
					</span>
					<span class="font-mono text-xs uppercase tracking-widest text-bone">
						Rixel<span class="text-accent">.</span>dev
					</span>
				</a>

				<p class="max-w-sm font-display text-3xl leading-tight text-bone">
					{i18n.FOOTER_TAGLINE}
				</p>

				<p class="font-mono text-xs uppercase tracking-widest text-secondary">
					{i18n.HOME_LOCATION}
				</p>

				<ul class="flex flex-wrap items-center gap-2">
					{
						socialLinks.map((link) => (
							<li>
								<a
									target="_blank"
									href={link.href}
									rel="noopener noreferrer"
									aria-label={link.label}
									class="inline-flex size-10 items-center justify-center rounded-xl border border-line text-secondary transition-colors duration-300 hover:border-accent/40 hover:text-accent"
								>
									<link.icon class="size-4" />
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7">
				{
					columns.map((column) => (
						<div class="flex flex-col gap-4">
							<h2 class="font-mono text-xs uppercase tracking-widest text-secondary">
								{column.title}
							</h2>
							<ul class="flex flex-col gap-2.5">
								{column.links.map((link) => (
									<li>
										<a
											href={resolveLocalizedHref(link.href, locale)}
											class="link-underline text-sm text-primary transition-colors hover:text-bone"
										>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>

		<div
			class="flex flex-col gap-3 border-t border-line pt-6 font-mono text-xs text-secondary sm:flex-row sm:items-center sm:justify-between"
		>
			<p>&copy; {year} RixelDev · Rikelvi Capellán García</p>
			<p class="flex items-center gap-1.5">
				<span class="size-1.5 rounded-full bg-success"></span>
				{i18n.FOOTER_BUILT}
			</p>
		</div>
	</div>
</footer>
