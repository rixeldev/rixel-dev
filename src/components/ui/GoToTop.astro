---
import UpArrow from "@/icons/UpArrow.astro"
---

<a
	id="go-top-btn"
	class="group fixed bottom-20 right-5 z-30 flex size-11 cursor-pointer items-center justify-center rounded-full border border-line bg-ink-soft/80 text-bone shadow-lg shadow-black/40 backdrop-blur-md transition-colors duration-300 hover:border-accent/50 hover:text-accent"
	aria-label="Back to top"
>
	<UpArrow class="size-4 transition-transform duration-300 group-hover:-translate-y-0.5" />
</a>

<style>
	#go-top-btn {
		visibility: hidden;
		opacity: 0;
		animation: visibility linear both;
		animation-timeline: scroll();
		animation-range: 0 200px;
	}

	@keyframes visibility {
		to {
			visibility: visible;
			opacity: 1;
		}
	}
</style>

<script>
	import { $ } from "@/libs/dom-selector"

	document.addEventListener("astro:page-load", () => {
		const goToTopBtn = $("#go-top-btn") as HTMLAnchorElement
		if (!goToTopBtn || goToTopBtn.dataset.topReady === "true") return
		goToTopBtn.dataset.topReady = "true"

		goToTopBtn.addEventListener("click", () => {
			window.scrollTo({ top: 0, behavior: "smooth" })
		})
	})
</script>
