---
// Full-page atmosphere: single acid aurora, soft brand glows and a vignette
// that keeps the edges anchored to ink.
---

<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden bg-ink" aria-hidden="true">
	<div class="aurora-field absolute inset-0"></div>

	<div
		class="absolute -top-52 left-1/2 size-96 -translate-x-1/2 rounded-full bg-accent/10 blur-3xl"
	>
	</div>
	<div class="absolute -right-40 top-1/3 size-96 rounded-full bg-success/5 blur-3xl"></div>

	<div class="absolute inset-x-0 bottom-0 h-72 bg-gradient-to-t from-ink via-ink/80 to-transparent">
	</div>
</div>
