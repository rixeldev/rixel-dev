---
import RightArrow from "@/icons/RightArrow.astro"
import { getActiveLocale, getI18N, getLanguageLabel, resolveLocalizedHref } from "@/locales/index"

interface Props {
	category: string
	cover: string
	description: string
	lang: string
	pageTitle: string
	readingMinutes: number
	tags: string[]
	timestamp: string
	title: string
	locale?: string
}

const {
	category,
	cover,
	description,
	lang,
	pageTitle,
	readingMinutes,
	tags,
	timestamp,
	title,
	locale: propLocale,
} = Astro.props

const locale = propLocale ?? getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })

const articleHref = resolveLocalizedHref(`/articles/${pageTitle}`, locale)
const languageLabel = getLanguageLabel(lang, i18n)
const searchIndex = `${title} ${description} ${category} ${tags.join(" ")}`.toLowerCase()
---

<article
	data-article
	data-search={searchIndex}
	data-tags={tags.join("|")}
	class="group flex h-full min-w-0 flex-col"
>
	<a href={articleHref} class="flex h-full flex-col gap-5" title={`${i18n.READ} → ${title}`}>
		<div class="relative overflow-hidden rounded-3xl border border-line bg-ink-panel">
			<img
				src={cover}
				alt={`Rixel article ${title}`}
				width="1280"
				height="720"
				loading="lazy"
				decoding="async"
				class="aspect-video w-full object-cover object-top opacity-85 transition-all duration-700 group-hover:scale-105 group-hover:opacity-100"
			/>

			<span
				class="absolute left-4 top-4 rounded-full border border-line bg-ink/75 px-3 py-1 font-mono text-xs uppercase tracking-wider text-accent backdrop-blur-md"
			>
				{category}
			</span>
		</div>

		<div class="flex flex-1 flex-col gap-3">
			<div
				class="flex flex-wrap items-center gap-2 font-mono text-xs uppercase tracking-wider text-secondary"
			>
				<time datetime={timestamp}>{timestamp}</time>
				<span aria-hidden="true">·</span>
				<span>{i18n.ARTICLE_READING_TIME.replace("{minutes}", String(readingMinutes))}</span>
				<span aria-hidden="true">·</span>
				<span>{languageLabel}</span>
			</div>

			<h3
				class="line-clamp-2 font-display text-2xl leading-snug text-bone transition-colors duration-300 group-hover:text-accent"
				transition:name={`article-${pageTitle}-title`}
			>
				{title}
			</h3>

			<p class="line-clamp-2 text-sm leading-relaxed text-primary">{description}</p>

			<span
				class="mt-auto inline-flex items-center gap-2 pt-2 font-mono text-xs uppercase tracking-widest text-secondary transition-colors group-hover:text-accent"
			>
				{i18n.READ}
				<RightArrow class="size-3.5 transition-transform group-hover:translate-x-1" />
			</span>
		</div>
	</a>
</article>
