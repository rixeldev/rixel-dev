---
interface Props {
	title: string
	description: string
	date: string
}

const { title, description } = Astro.props
---

<div class="flex flex-col gap-3">
	<h3
		class="font-display text-2xl text-bone transition-colors duration-300 group-hover:text-accent sm:text-3xl"
	>
		{title}
	</h3>

	<p class="max-w-xl text-pretty text-sm leading-relaxed text-primary sm:text-base">
		{description}
	</p>
</div>
