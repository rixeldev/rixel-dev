---
import GitHub from "@/icons/GitHub.astro"
import RightArrow from "@/icons/RightArrow.astro"
import { getActiveLocale, getI18N } from "@/locales/index.ts"

interface Props {
	title: string
	description: string
	imgUrl: string
	projectUrl: string
	tags: {
		name: string
		class: string
		iconColor: string
		icon: any
	}[]
	gitCodeUrl: string
	alt: string
}

const { title, description, imgUrl, projectUrl, tags, gitCodeUrl, alt } = Astro.props
const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
---

<article
	class="group flex h-full min-w-0 flex-col overflow-hidden rounded-3xl border border-line bg-ink-panel"
>
	<a
		href={projectUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="relative block overflow-hidden"
		aria-label={`${title} — ${i18n.SQUINT}`}
	>
		<img
			src={imgUrl}
			alt={alt}
			width="1280"
			height="720"
			decoding="async"
			loading="lazy"
			class="aspect-video w-full object-cover object-top opacity-90 transition-all duration-700 group-hover:scale-105 group-hover:opacity-100"
		/>

		<span
			class="absolute right-4 top-4 flex size-9 translate-y-1 items-center justify-center rounded-full bg-accent text-accent-ink opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100"
		>
			<RightArrow class="size-4 -rotate-45" />
		</span>
	</a>

	<div class="flex flex-1 flex-col gap-3 p-6">
		<ul class="flex flex-wrap gap-2">
			{
				tags.map((tag) => (
					<li class="inline-flex items-center gap-1.5 rounded-full border border-line px-2.5 py-1 font-mono text-xs text-secondary">
						<tag.icon class="size-3" />
						{tag.name}
					</li>
				))
			}
		</ul>

		<h3 class="font-display text-2xl text-bone">
			<a
				href={projectUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="transition-colors hover:text-accent"
			>
				{title}
			</a>
		</h3>

		<p class="line-clamp-3 text-sm leading-relaxed text-primary">{description}</p>

		<footer class="mt-auto flex items-center justify-between gap-4 border-t border-line pt-4">
			<a
				href={projectUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-accent"
			>
				{i18n.SQUINT}
				<RightArrow class="size-3.5 transition-transform group-hover:translate-x-0.5" />
			</a>

			<a
				href={gitCodeUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`${title} — GitHub`}
				class="text-secondary transition-colors hover:text-bone"
			>
				<GitHub class="size-4" />
			</a>
		</footer>
	</div>
</article>
