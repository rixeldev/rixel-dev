---
interface Props {
	id?: string
	eyebrow?: string
}

const { id, eyebrow } = Astro.props as Props
---

<div class="mb-8 flex flex-col gap-3">
	<div class="h-px w-12 rounded-full bg-gradient-to-r from-accent to-transparent"></div>

	{
		eyebrow ? (
			<p class="text-xs font-semibold uppercase tracking-[0.28em] text-accent/80">{eyebrow}</p>
		) : null
	}

	<h2
		id={id}
		class="flex items-center gap-x-3 text-2xl font-bold tracking-tight text-slate-100 sm:text-3xl"
	>
		<slot />
	</h2>
</div>
