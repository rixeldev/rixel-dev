---
interface Props {
	id?: string
	eyebrow?: string
	title?: string
	align?: "start" | "center"
}

const { id, eyebrow, title, align = "start" } = Astro.props as Props
---

<div class:list={["flex flex-col gap-5", align === "center" && "items-center text-center"]}>
	<div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-secondary">
		<span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
		{eyebrow ? <span>{eyebrow}</span> : null}
	</div>

	<h2
		id={id}
		class="display-balance font-display text-4xl font-semibold leading-none tracking-tight text-bone sm:text-5xl lg:text-6xl"
	>
		{title ?? <slot />}
	</h2>
</div>
