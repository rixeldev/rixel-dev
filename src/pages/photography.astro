---
import MainTitle from "@/components/MainTitle.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import type { Preload } from "@/interfaces/preload"
import { imageMimeType } from "@/libs/images"
import { getActiveLocale, getI18N, resolveLocalizedPath } from "@/locales/index"
import { getImages } from "@/services/images"
import "photoswipe/style.css"
import Layout from "../layouts/Layout.astro"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const images = getImages().sort(() => Math.random() - 0.5)
const firstImage = images[0]
const preloads: Preload[] = firstImage
	? [
			{
				as: "image",
				href: `/${firstImage.src}`,
				type: imageMimeType(firstImage.src),
				rel: "preload",
			},
		]
	: []
---

<Layout
	title={`${i18n.PHOTOGRAPHY} - Rixel`}
	description={i18n.PHOTOGRAPHY_PAGE_DESCRIPTION}
	canonical={new URL(resolveLocalizedPath("/photography/", locale), "https://rixel.dev").toString()}
	preload={preloads}
>
	<SectionContainer class="pb-12 pt-32 sm:pt-36">
		<div class="flex w-full flex-col gap-10">
			<div class="grid items-end gap-8 lg:grid-cols-12">
				<div class="flex flex-col gap-6 lg:col-span-8">
					<MainTitle eyebrow={i18n.PHOTOGRAPHY_PORTFOLIO_TITLE} title={i18n.PHOTOGRAPHY} />

					<p class="max-w-2xl text-pretty text-base leading-relaxed text-primary sm:text-lg">
						{i18n.PHOTOGRAPHY_DESCRIPTION}
					</p>
				</div>

				<p
					class="font-mono text-xs uppercase tracking-widest text-secondary lg:col-span-4 lg:text-right"
				>
					<span class="text-accent">{images.length}</span> · {i18n.MY_PHOTOS}
				</p>
			</div>
		</div>
	</SectionContainer>

	<div class="px-4 pb-24 sm:px-6 lg:px-8">
		<div id="gallery" class="masonry mx-auto w-full max-w-6xl">
			{
				images.map((image, index) => (
					<a
						href={`/${image.src}`}
						data-pswp-width={image.width}
						data-pswp-height={image.height}
						target="_blank"
						class="group relative mb-4 block cursor-zoom-in break-inside-avoid overflow-hidden rounded-2xl border border-line bg-ink-panel"
						aria-label={`${i18n.PHOTOGRAPHY_IMAGE_ALT_PREFIX} ${index + 1}`}
					>
						<img
							src={`/${image.src}`}
							alt={`${i18n.PHOTOGRAPHY_IMAGE_ALT_PREFIX} ${index + 1}`}
							width={image.width}
							height={image.height}
							loading={index === 0 ? "eager" : "lazy"}
							fetchpriority={index === 0 ? "high" : undefined}
							decoding="async"
							class="w-full rounded-2xl transition-all duration-500 ease-out group-hover:scale-105 group-hover:brightness-110"
						/>

						<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
					</a>
				))
			}
		</div>
	</div>
</Layout>

<style>
	.masonry {
		column-gap: 1rem;
		column-width: 16rem;
	}
</style>

<script>
	import PhotoSwipeLightbox from "photoswipe/lightbox"
	import "photoswipe/style.css"

	let lightbox: PhotoSwipeLightbox | null = null

	const setupGallery = () => {
		const gallery = document.querySelector("#gallery")
		if (!gallery) return

		if (lightbox) {
			lightbox.destroy()
			lightbox = null
		}

		lightbox = new PhotoSwipeLightbox({
			gallery: "#gallery",
			children: "a",
			showAnimationDuration: 200,
			hideAnimationDuration: 200,
			zoomAnimationDuration: 200,
			showHideAnimationType: "zoom",
			pswpModule: () => import("photoswipe"),
		})

		lightbox.init()
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", setupGallery, { once: true })
	} else {
		setupGallery()
	}

	document.addEventListener("astro:page-load", setupGallery)

	document.addEventListener("astro:before-swap", () => {
		if (lightbox) {
			lightbox.destroy()
			lightbox = null
		}
	})
</script>
