---
import AppCard from "@/components/apps/AppCard.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import ActionLink from "@/components/ui/ActionLink.astro"
import RightArrow from "@/icons/RightArrow.astro"
import Layout from "@/layouts/Layout.astro"
import { buildAppsIndexJsonLd, SITE_URL } from "@/libs/structuredData"
import {
	getActiveLocale,
	getI18N,
	resolveLocalizedHref,
	resolveLocalizedPath,
} from "@/locales/index"
import { appsService } from "@/services/apps"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const apps = appsService(locale)
const canonical = new URL(resolveLocalizedPath("/apps/", locale), SITE_URL).toString()

const appLinks = apps.map((app) => ({
	name: app.name,
	description: app.intro,
	icon: new URL(app.icon, SITE_URL).toString(),
	url: new URL(resolveLocalizedHref(`/apps/${app.slug}`, locale), SITE_URL).toString(),
	tagline: app.tagline,
	playUrl: app.playUrl,
}))

const jsonLd = buildAppsIndexJsonLd({
	name: i18n.APPS_PAGE_TITLE,
	description: i18n.APPS_PAGE_DESCRIPTION,
	url: canonical,
	apps: appLinks,
})
---

<Layout
	title={i18n.APPS_PAGE_TITLE}
	description={i18n.APPS_PAGE_DESCRIPTION}
	canonical={canonical}
	image={new URL(apps[0]?.featureGraphic.src ?? "/images/embedded-img.avif", SITE_URL).toString()}
	imageWidth={apps[0]?.featureGraphic.width ?? 1280}
	imageHeight={apps[0]?.featureGraphic.height ?? 720}
	keywords="RixelDev apps, Stop Trivia, Setuno, Android apps, Google Play, React Native"
	jsonLd={jsonLd}
>
	<SectionContainer class="pb-0 pt-32 sm:pt-36">
		<div class="flex w-full flex-col gap-10">
			<nav aria-label="Breadcrumb">
				<ol
					class="flex flex-wrap items-center gap-2 font-mono text-xs uppercase tracking-wider text-secondary"
				>
					<li>
						<a href={resolveLocalizedHref("/", locale)} class="transition-colors hover:text-accent">
							{i18n.HOME}
						</a>
					</li>
					<li aria-hidden="true">/</li>
					<li>
						<span class="text-bone" aria-current="page">{i18n.APPS}</span>
					</li>
				</ol>
			</nav>

			<div class="grid items-end gap-12 lg:grid-cols-12 lg:gap-10">
				<div class="flex flex-col gap-7 lg:col-span-8">
					<div class="flex flex-col gap-5">
						<div
							class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-secondary"
						>
							<span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
							<span>{i18n.APPS_EYEBROW}</span>
						</div>

						<h1
							class="display-balance font-display text-4xl font-semibold leading-none tracking-tight text-bone sm:text-5xl lg:text-6xl"
						>
							{i18n.APPS_TITLE}
						</h1>
					</div>

					<p class="max-w-2xl text-pretty text-base leading-relaxed text-primary sm:text-lg">
						{i18n.APPS_SUBTITLE}
					</p>

					<p class="font-mono text-xs uppercase tracking-widest text-secondary">
						<span class="text-accent">{apps.length}</span>
						{i18n.APPS_COUNT}
					</p>
				</div>

				<div class="lg:col-span-4">
					<div class="flex flex-col gap-5 rounded-4xl border border-line bg-ink-panel p-6 sm:p-7">
						<div class="flex items-center gap-3">
							<span class="relative flex size-2">
								<span class="absolute inset-0 animate-ping rounded-full bg-accent opacity-60"
								></span>
								<span class="relative size-2 rounded-full bg-accent"></span>
							</span>
							<span class="font-mono text-xs uppercase tracking-widest text-secondary">
								{i18n.APPS_BADGE}
							</span>
						</div>

						<div class="flex -space-x-4">
							{
								apps.map((app) => (
									<img
										src={app.icon}
										alt={`${app.name} icon`}
										width="80"
										height="80"
										loading="lazy"
										decoding="async"
										class="size-20 rounded-2xl border border-line object-cover shadow-lg shadow-black/40"
									/>
								))
							}
						</div>

						<div class="flex items-end justify-between gap-4 border-t border-line pt-5">
							<span class="font-display text-4xl font-semibold leading-none text-bone">
								{apps.length}
							</span>
							<span class="text-right font-mono text-xs uppercase tracking-wider text-secondary">
								{i18n.APPS_AVAILABLE}
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</SectionContainer>

	<SectionContainer class="pb-0 pt-10 sm:pt-12">
		<div class="grid w-full gap-4 md:grid-cols-2">
			{apps.map((app) => <AppCard app={app} />)}
		</div>
	</SectionContainer>

	<SectionContainer class="pb-24 pt-16 sm:pt-20">
		<div
			class="grid w-full gap-8 rounded-5xl border border-line bg-ink-soft/70 p-7 sm:p-10 lg:grid-cols-12 lg:items-center"
		>
			<div class="flex flex-col gap-4 lg:col-span-8">
				<h2
					class="display-balance font-display text-3xl font-semibold leading-none tracking-tight text-bone sm:text-4xl"
				>
					{i18n.APPS_MORE_TITLE}
				</h2>
				<p class="max-w-xl text-pretty text-sm leading-relaxed text-primary sm:text-base">
					{i18n.APPS_MORE_TEXT}
				</p>
			</div>

			<div class="lg:col-span-4 lg:justify-self-end">
				<ActionLink href="#contact" variant="ghost" size="lg">
					{i18n.HOME_CTA_CONTACT}
					<RightArrow
						class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
					/>
				</ActionLink>
			</div>
		</div>
	</SectionContainer>
</Layout>
