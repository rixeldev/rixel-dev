---
import MainTitle from "@/components/MainTitle.astro"
import PhotographyCard from "@/components/PhotographyCard.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import AboutMe from "@/components/web/AboutMe.astro"
import Articles from "@/components/web/Articles.astro"
import FeaturedProjects from "@/components/web/FeaturedProjects.astro"
import HomeHero from "@/components/web/HomeHero.astro"
import Services from "@/components/web/Services.astro"
import Photography from "@/icons/Photography.astro"
import type { Preload } from "@/interfaces/preload"
import { getActiveLocale, getI18N, resolveLocalizedPath } from "@/locales/index"
import Layout from "../layouts/Layout.astro"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const canonical = new URL(resolveLocalizedPath("/", locale), "https://rixel.dev").toString()

const preloadImages: Preload[] = [
	{
		as: "image",
		href: `https://rixel.dev/images/main-pic.webp`,
		type: "image/webp",
		rel: "preload",
	},
	{
		as: "image",
		href: `https://rixel.dev/images/about-image.webp`,
		type: "image/webp",
		rel: "preload",
	},
]
---

<Layout
	title={i18n.HOME_PAGE_TITLE}
	description={i18n.HOME_PAGE_DESCRIPTION}
	canonical={canonical}
	preload={preloadImages}
>
	<SectionContainer id="web" class="!pb-12 !pt-28 md:!pt-36">
		<HomeHero />
	</SectionContainer>

	<SectionContainer id="services" class="!py-16">
		<Services />
	</SectionContainer>

	<SectionContainer id="featured" class="!py-16">
		<FeaturedProjects />
	</SectionContainer>

	<SectionContainer class="!py-16">
		<div class="grid w-full min-w-0 max-w-6xl gap-10 sm:w-11/12 lg:grid-cols-5 lg:gap-8">
			<div class="fade-up-anim min-w-0 lg:col-span-3">
				<Articles />
			</div>

			<div class="fade-up-anim flex min-w-0 flex-col lg:col-span-2">
				<MainTitle eyebrow={i18n.PHOTOGRAPHY}>
					<Photography class="size-7 text-accent" />
					{i18n.PHOTOGRAPHY}
				</MainTitle>

				<PhotographyCard />
			</div>
		</div>
	</SectionContainer>

	<SectionContainer id="about" class="!py-16">
		<AboutMe />
	</SectionContainer>
</Layout>
