---
import SectionContainer from "@/components/SectionContainer.astro"
import AboutMe from "@/components/web/AboutMe.astro"
import AppsShowcase from "@/components/web/AppsShowcase.astro"
import Articles from "@/components/web/Articles.astro"
import FeaturedProjects from "@/components/web/FeaturedProjects.astro"
import HomeHero from "@/components/web/HomeHero.astro"
import PhotographyTeaser from "@/components/web/PhotographyTeaser.astro"
import Services from "@/components/web/Services.astro"
import TechMarquee from "@/components/web/TechMarquee.astro"
import type { Preload } from "@/interfaces/preload"
import { getActiveLocale, getI18N, resolveLocalizedPath } from "@/locales/index"
import Layout from "../layouts/Layout.astro"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const canonical = new URL(resolveLocalizedPath("/", locale), "https://rixel.dev").toString()

const preloadImages: Preload[] = [
	{
		as: "image",
		href: "/images/main-pic.webp",
		type: "image/webp",
		rel: "preload",
	},
]
---

<Layout
	title={i18n.HOME_PAGE_TITLE}
	description={i18n.HOME_PAGE_DESCRIPTION}
	canonical={canonical}
	preload={preloadImages}
>
	<SectionContainer id="web" class="pb-20 pt-32 sm:pt-40">
		<HomeHero />
	</SectionContainer>

	<TechMarquee />

	<SectionContainer id="apps" class="sm:py-24">
		<AppsShowcase />
	</SectionContainer>

	<SectionContainer id="services" class="border-t border-line sm:py-24">
		<Services />
	</SectionContainer>

	<SectionContainer id="work" class="border-t border-line sm:py-24">
		<FeaturedProjects />
	</SectionContainer>

	<SectionContainer id="journal" class="border-t border-line sm:py-24">
		<div class="grid w-full min-w-0 gap-10 lg:grid-cols-12 lg:gap-12">
			<div class="lg:col-span-7">
				<Articles />
			</div>
			<div class="lg:col-span-5">
				<PhotographyTeaser />
			</div>
		</div>
	</SectionContainer>

	<SectionContainer id="about" class="border-t border-line sm:py-24">
		<AboutMe />
	</SectionContainer>
</Layout>
