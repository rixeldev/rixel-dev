---
import ArticleTile from "@/components/ArticleTile.astro"
import MainTitle from "@/components/MainTitle.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import type { Preload } from "@/interfaces/preload"
import {
	buildArticlesIndexJsonLd,
	estimateReadingTime,
	resolveCoverUrl,
	sortArticlesByDate,
} from "@/libs/articlesSeo"
import { imageMimeType, isLocalAsset } from "@/libs/images"
import {
	getActiveLocale,
	getI18N,
	resolveLocalizedHref,
	resolveLocalizedPath,
} from "@/locales/index"
import { getCollection } from "astro:content"
import Layout from "../layouts/Layout.astro"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const articles = sortArticlesByDate(await getCollection("articles"))
const orderedArticles = [...articles].sort(
	(a, b) => Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured))
)
const canonical = new URL(
	resolveLocalizedPath("/articles/", locale),
	"https://rixel.dev"
).toString()
const pageTitle = i18n.ARTICLES_INDEX_TITLE
const pageDescription = i18n.ARTICLES_INDEX_SEO_DESCRIPTION
const featuredImage = articles[0]?.data.cover
	? resolveCoverUrl(articles[0].data.cover)
	: "https://rixel.dev/images/embedded-img.avif"
const firstCover = orderedArticles[0]?.data.cover
const preloads: Preload[] =
	firstCover && isLocalAsset(firstCover)
		? [{ as: "image", href: firstCover, type: imageMimeType(firstCover), rel: "preload" }]
		: []
const jsonLd = buildArticlesIndexJsonLd({
	articles,
	locale,
	title: pageTitle,
	description: pageDescription,
	canonical,
})

const tagFrequency = new Map<string, number>()
articles.forEach((article) => {
	article.data.tags.forEach((tag) => {
		tagFrequency.set(tag, (tagFrequency.get(tag) ?? 0) + 1)
	})
})
const topTags = [...tagFrequency.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, 8)
	.map(([tag]) => tag)
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonical={canonical}
	image={featuredImage}
	keywords={i18n.ARTICLES_INDEX_KEYWORDS}
	jsonLd={jsonLd}
	preload={preloads}
>
	<SectionContainer class="pt-32 sm:pt-36">
		<div class="flex w-full flex-col gap-10">
			<nav aria-label="Breadcrumb">
				<ol
					class="flex flex-wrap items-center gap-2 font-mono text-xs uppercase tracking-wider text-secondary"
				>
					<li>
						<a href={resolveLocalizedHref("/", locale)} class="transition-colors hover:text-accent">
							{i18n.HOME}
						</a>
					</li>
					<li aria-hidden="true">/</li>
					<li>
						<span class="text-bone" aria-current="page">{i18n.ARTICLES}</span>
					</li>
				</ol>
			</nav>

			<div class="grid items-end gap-8 lg:grid-cols-12">
				<div class="flex flex-col gap-6 lg:col-span-8">
					<MainTitle eyebrow={i18n.ARTICLES_EYEBROW} title={i18n.ARTICLES} />

					<p class="max-w-2xl text-pretty text-base leading-relaxed text-primary sm:text-lg">
						{pageDescription}
					</p>
				</div>

				<p
					class="font-mono text-xs uppercase tracking-widest text-secondary lg:col-span-4 lg:text-right"
				>
					<span class="text-accent" data-article-count>{articles.length}</span>
					{i18n.ARTICLES_RESULTS}
				</p>
			</div>

			<div
				class="flex w-full flex-col gap-4 rounded-3xl border border-line bg-ink-soft/70 p-4 backdrop-blur-lg sm:p-5"
			>
				<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
					<label class="relative w-full sm:max-w-sm">
						<span class="sr-only">{i18n.ARTICLES_SEARCH_LABEL}</span>
						<input
							type="search"
							data-article-search
							placeholder={i18n.ARTICLES_SEARCH_PLACEHOLDER}
							class="h-11 w-full rounded-full border border-line bg-ink/70 px-4 text-sm text-bone outline-none transition-colors placeholder:text-secondary/70 focus:border-accent/50"
						/>
					</label>

					<p class="font-mono text-xs uppercase tracking-wider text-secondary" aria-live="polite">
						{i18n.ARTICLES_FILTER_LABEL}
					</p>
				</div>

				<div class="flex flex-wrap gap-2" role="group" aria-label={i18n.ARTICLES_FILTER_LABEL}>
					<button
						type="button"
						class="filter-chip"
						data-tag-filter
						data-tag="all"
						data-active="true"
					>
						{i18n.ARTICLES_FILTER_ALL}
					</button>
					{
						topTags.map((tag) => (
							<button type="button" class="filter-chip" data-tag-filter data-tag={tag}>
								{tag}
							</button>
						))
					}
				</div>
			</div>

			<section
				class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10"
				aria-label={i18n.ARTICLES}
			>
				{
					orderedArticles.map((article) => {
						const { category, cover, description, lang, pageTitle, tags, timestamp, title } =
							article.data

						return (
							<ArticleTile
								category={category}
								cover={cover}
								description={description}
								lang={lang}
								pageTitle={pageTitle}
								readingMinutes={estimateReadingTime(article.body)}
								tags={tags}
								timestamp={timestamp}
								title={title}
							/>
						)
					})
				}
			</section>

			<p data-article-empty hidden class="text-center text-primary">
				{i18n.ARTICLES_NO_RESULTS}
			</p>
		</div>
	</SectionContainer>
</Layout>

<style>
	.filter-chip {
		@apply rounded-full border border-line bg-bone/5 px-3 py-1.5 font-mono text-xs text-secondary transition-colors duration-200;
	}

	.filter-chip:hover {
		@apply border-accent/40 text-accent;
	}

	.filter-chip[data-active="true"] {
		@apply border-accent bg-accent text-accent-ink;
	}
</style>

<script>
	const setupArticleFilters = () => {
		const input = document.querySelector<HTMLInputElement>("[data-article-search]")
		const tiles = Array.from(document.querySelectorAll<HTMLElement>("[data-article]"))
		const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]"))
		const count = document.querySelector<HTMLElement>("[data-article-count]")
		const empty = document.querySelector<HTMLElement>("[data-article-empty]")

		if (!input || tiles.length === 0) return
		if (input.dataset.filterReady === "true") return
		input.dataset.filterReady = "true"

		let activeTag = "all"
		let query = ""

		const applyFilters = () => {
			let visible = 0

			tiles.forEach((tile) => {
				const search = (tile.dataset.search ?? "").toLowerCase()
				const tags = (tile.dataset.tags ?? "").split("|")
				const matchesQuery = query.length === 0 || search.includes(query)
				const matchesTag = activeTag === "all" || tags.includes(activeTag)
				const show = matchesQuery && matchesTag
				tile.hidden = !show
				if (show) visible += 1
			})

			if (count) count.textContent = String(visible)
			if (empty) empty.hidden = visible !== 0
		}

		input.addEventListener("input", () => {
			query = input.value.trim().toLowerCase()
			applyFilters()
		})

		chips.forEach((chip) => {
			chip.addEventListener("click", () => {
				activeTag = chip.dataset.tag ?? "all"
				chips.forEach((other) => {
					other.dataset.active = other === chip ? "true" : "false"
				})
				applyFilters()
			})
		})
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", setupArticleFilters, { once: true })
	} else {
		setupArticleFilters()
	}

	document.addEventListener("astro:page-load", setupArticleFilters)
</script>
