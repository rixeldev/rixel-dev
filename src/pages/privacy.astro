---
import LegalPage from "@/components/legal/LegalPage.astro"
import Layout from "@/layouts/Layout.astro"
import { buildBreadcrumbJsonLd } from "@/libs/articlesSeo"
import { SITE_URL } from "@/libs/structuredData"
import { getActiveLocale, getI18N, resolveLocalizedPath } from "@/locales/index"
import { getLegalDocument } from "@/services/legal"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const document = getLegalDocument("privacy", locale)

const canonical = new URL(resolveLocalizedPath("/privacy/"), SITE_URL).toString()
const jsonLd = buildBreadcrumbJsonLd([
	{ name: i18n.HOME, item: SITE_URL },
	{ name: document.title, item: canonical },
])
---

<Layout
	title={`${document.title} - Rixel`}
	description={document.description}
	canonical={canonical}
	keywords={`privacy policy, data protection, account deletion, Stop Trivia, Setuno, RixelDev, Rikelvi Capellán`}
	jsonLd={jsonLd}
	contact={false}
>
	<LegalPage document={document} locale={locale} />
</Layout>
