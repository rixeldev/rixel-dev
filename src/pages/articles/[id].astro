---
import ArticleTile from "@/components/ArticleTile.astro"
import Badge from "@/components/Badge.astro"
import MainTitle from "@/components/MainTitle.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import RightArrow from "@/icons/RightArrow.astro"
import Layout from "@/layouts/Layout.astro"
import {
	buildArticleJsonLd,
	buildBreadcrumbJsonLd,
	estimateReadingTime,
	findTranslation,
	formatArticleIsoDate,
	getRelatedArticles,
	resolveCoverUrl,
	sortArticlesByDate,
} from "@/libs/articlesSeo"
import {
	getActiveLocale,
	getI18N,
	resolveLocalizedHref,
	resolveLocalizedPath,
} from "@/locales/index"
import { getCollection, render } from "astro:content"

export const prerender = true

export async function getStaticPaths() {
	const articles = await getCollection("articles")

	return articles.map((article: any) => ({
		params: { id: article.slug },
		props: { article },
	}))
}

const { article } = Astro.props
const { data } = article
const { author, category, cover, description, lang, pageTitle, tags, timestamp, title } = data
const { Content } = await render(article)

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
const collection = sortArticlesByDate(await getCollection("articles"))
const readingMinutes = estimateReadingTime(article.body)
const relatedArticles = getRelatedArticles(collection, article)
const translation = findTranslation(collection, article)

const canonical = new URL(
	resolveLocalizedPath(`/articles/${pageTitle}/`, locale),
	"https://rixel.dev"
).toString()

const alternates = translation
	? [
			{
				lang: translation.data.lang,
				href: new URL(
					resolveLocalizedPath(`/articles/${translation.data.pageTitle}/`, locale),
					"https://rixel.dev"
				).toString(),
			},
		]
	: []

const jsonLd = [
	buildArticleJsonLd({ article, canonical, readingMinutes }),
	buildBreadcrumbJsonLd([
		{ name: i18n.HOME, item: "https://rixel.dev" },
		{ name: i18n.ARTICLES, item: "https://rixel.dev/articles/" },
		{ name: title, item: canonical },
	]),
]
---

<Layout
	title={`${title} — ${category} | Rixel`}
	description={description}
	canonical={canonical}
	image={resolveCoverUrl(cover)}
	imageWidth={1280}
	imageHeight={720}
	keywords={[...tags, category, author].join(", ")}
	type="article"
	publishedTime={formatArticleIsoDate(timestamp)}
	modifiedTime={formatArticleIsoDate(timestamp)}
	author={author}
	section={category}
	tags={tags}
	alternates={alternates}
	jsonLd={jsonLd}
>
	<SectionContainer class="pt-32 sm:pt-36">
		<article class="flex w-full max-w-3xl flex-col">
			<nav aria-label="Breadcrumb">
				<ol
					class="flex flex-wrap items-center gap-2 font-mono text-xs uppercase tracking-wider text-secondary"
				>
					<li>
						<a href={resolveLocalizedHref("/", locale)} class="transition-colors hover:text-accent">
							{i18n.HOME}
						</a>
					</li>
					<li aria-hidden="true">/</li>
					<li>
						<a
							href={resolveLocalizedHref("/articles", locale)}
							class="transition-colors hover:text-accent"
						>
							{i18n.ARTICLES}
						</a>
					</li>
					<li aria-hidden="true">/</li>
					<li class="min-w-0">
						<span class="line-clamp-1 text-bone" aria-current="page">{title}</span>
					</li>
				</ol>
			</nav>

			<header class="mt-10 flex flex-col gap-6">
				<div
					class="flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-wider text-secondary"
				>
					<span class="rounded-full border border-accent/35 bg-accent/10 px-3 py-1 text-accent">
						{category}
					</span>
					<time datetime={formatArticleIsoDate(timestamp)}>{timestamp}</time>
					<span aria-hidden="true">·</span>
					<span>{i18n.ARTICLE_READING_TIME.replace("{minutes}", String(readingMinutes))}</span>
					<span aria-hidden="true">·</span>
					<span>{lang}</span>
				</div>

				<h1
					class="display-balance font-display text-4xl font-semibold leading-tight tracking-tight text-bone sm:text-5xl"
					transition:name={`article-${pageTitle}-title`}
				>
					{title}
				</h1>

				<p class="text-pretty text-base leading-relaxed text-primary sm:text-lg">
					{description}
				</p>
			</header>

			<img
				src={cover}
				alt={`Rixel's article ${title}`}
				width="1280"
				height="720"
				class="mt-10 aspect-video w-full rounded-3xl border border-line object-cover"
			/>

			<div class="article-prose mt-12 w-full" transition:name={`article-${pageTitle}-content`}>
				<Content />
			</div>

			<footer class="mt-14 flex flex-col gap-6 border-t border-line pt-8">
				<div class="flex flex-wrap items-center gap-2">
					<span class="mr-1 font-mono text-xs uppercase tracking-wider text-secondary"
						>{i18n.ARTICLE_TAGS}:</span
					>
					{
						tags.map((tag: string) => (
							<Badge>
								<span class="font-mono text-xs">{tag}</span>
							</Badge>
						))
					}
				</div>

				<div class="flex flex-wrap items-center justify-between gap-4">
					<p class="font-mono text-xs uppercase tracking-wider text-secondary">
						{i18n.AUTHOR}: <span class="text-primary">{author}</span>
					</p>

					<div class="flex flex-wrap items-center gap-2">
						{
							translation ? (
								<a
									href={resolveLocalizedHref(`/articles/${translation.data.pageTitle}`, locale)}
									class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-4 py-2 text-sm font-semibold text-accent transition-colors hover:bg-accent/20"
								>
									{translation.data.lang === "es"
										? i18n.ARTICLE_READ_IN_SPANISH
										: i18n.ARTICLE_READ_IN_ENGLISH}
								</a>
							) : null
						}

						<button
							type="button"
							data-share-button
							data-share-title={title}
							data-copied-label={i18n.ARTICLE_LINK_COPIED}
							class="inline-flex items-center gap-2 rounded-full border border-line bg-bone/5 px-4 py-2 text-sm font-semibold text-primary transition-colors hover:border-accent/30 hover:text-accent"
						>
							{i18n.ARTICLE_SHARE}
						</button>

						<a
							href={resolveLocalizedHref("/articles", locale)}
							class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium text-secondary transition-colors hover:text-accent"
						>
							{i18n.ARTICLE_BACK}
							<RightArrow class="size-3.5" />
						</a>
					</div>
				</div>
			</footer>
		</article>

		{
			relatedArticles.length > 0 ? (
				<section class="mt-24 flex w-full flex-col">
					<MainTitle eyebrow={i18n.ARTICLES_EYEBROW} title={i18n.ARTICLE_RELATED} />

					<div class="mt-10 grid w-full gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10">
						{relatedArticles.map((related) => (
							<ArticleTile
								category={related.data.category}
								cover={related.data.cover}
								description={related.data.description}
								lang={related.data.lang}
								pageTitle={related.data.pageTitle}
								readingMinutes={estimateReadingTime(related.body)}
								tags={related.data.tags}
								timestamp={related.data.timestamp}
								title={related.data.title}
							/>
						))}
					</div>
				</section>
			) : null
		}
	</SectionContainer>
</Layout>

<script>
	document.addEventListener("astro:page-load", () => {
		const shareButton = document.querySelector<HTMLButtonElement>("[data-share-button]")
		if (!shareButton || shareButton.dataset.shareReady === "true") return
		shareButton.dataset.shareReady = "true"

		shareButton.addEventListener("click", async () => {
			const title = shareButton.dataset.shareTitle ?? document.title
			const url = window.location.href

			try {
				if (navigator.share) {
					await navigator.share({ title, url })
					return
				}

				await navigator.clipboard.writeText(url)
				window.toast({
					dismissible: true,
					icon: true,
					location: "bottom-center",
					title: shareButton.dataset.copiedLabel ?? "Link copied!",
					type: "success",
				})
			} catch {
				/* user cancelled or clipboard unavailable */
			}
		})
	})
</script>
