---
import SectionContainer from "@/components/SectionContainer.astro"
import ActionLink from "@/components/ui/ActionLink.astro"
import {
	getActiveLocale,
	getI18N,
	resolveLocalizedHref,
	resolveLocalizedPath,
} from "@/locales/index"
import Layout from "../layouts/Layout.astro"

const locale = getActiveLocale(Astro)
const i18n = getI18N({ currentLocale: locale })
---

<Layout
	title={i18n.ERROR_404_TITLE}
	description={i18n.ERROR_404_DESCRIPTION}
	canonical={new URL(resolveLocalizedPath("/404/", locale), "https://rixel.dev").toString()}
	contact={false}
>
	<SectionContainer class="pb-32 pt-40">
		<div class="flex w-full flex-col items-center gap-6 text-center">
			<span class="font-mono text-xs uppercase tracking-widest text-accent">Error 404</span>

			<p
				class="font-display text-8xl font-semibold leading-none tracking-tight text-bone sm:text-9xl"
			>
				404
			</p>

			<h1 class="font-display text-4xl font-semibold tracking-tight text-accent sm:text-5xl">
				{i18n.ERROR_404}
			</h1>

			<p class="max-w-md text-pretty text-sm leading-relaxed text-secondary">
				{i18n.ERROR_404_DESCRIPTION}
			</p>

			<div class="mt-4 flex flex-wrap items-center justify-center gap-3">
				<ActionLink href={resolveLocalizedHref("/", locale)}>{i18n.HOME}</ActionLink>
				<ActionLink href={resolveLocalizedHref("/apps", locale)} variant="ghost">
					{i18n.APPS}
				</ActionLink>
			</div>
		</div>
	</SectionContainer>
</Layout>
